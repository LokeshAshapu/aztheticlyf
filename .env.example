# Canonical site URL (used for SEO, sitemap and social metadata)
NEXT_PUBLIC_SITE_URL=https://aztheticlyf.com

# Google Analytics 4 — leave blank to disable
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta (Facebook/Instagram) Pixel — leave blank to disable
NEXT_PUBLIC_META_PIXEL_ID=

# ---------- Form backend (choose one) ----------

# Formspree (easiest, no coding required)
# 1. Sign up at https://formspree.io
# 2. Create a new form → give it a name (e.g. "aztheticlyf-enquiry")
# 3. Copy the form endpoint URL (it looks like: https://formspree.io/f/xxxxxxx)
# 4. Paste it below
NEXT_PUBLIC_FORM_ENDPOINT=https://formspree.io/f/xxxxxxx

# Basin (alternative, developer-friendly)
# 1. Sign up at https://basin.io
# 2. Create a new endpoint → copy the URL
# 3. Paste it below
# NEXT_PUBLIC_FORM_ENDPOINT=https://api.basin.io/v1/collect/xxxxxxx

# ---------- If left blank ----------
# The enquiry form will hand the message to WhatsApp pre-filled instead.
# No automated checkout, no middlemen. Every order starts with a WhatsApp message.